<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Van Smoorenburg Huisontruiming — Professionele woningontruiming in Leiden en omgeving. Discreet, snel en volledig geregeld." />
  <title>Van Smoorenburg Huisontruiming | Leiden en omgeving</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --navy:   #1B3A5C;
      --blue:   #2A5A8C;
      --sky:    #E8F0F8;
      --paper:  #F9F7F4;
      --warm:   #EEECe8;
      --line:   #DCDAD6;
      --ink:    #141414;
      --muted:  #787570;
      --serif:  'Instrument Serif', Georgia, serif;
      --sans:   'Geist', sans-serif;
    }

    html { scroll-behavior: smooth; }
    body { font-family: var(--sans); background: var(--paper); color: var(--ink); -webkit-font-smoothing: antialiased; }

    /* ── TOP BAR ── */
    .topbar {
      background: var(--navy);
      padding: 10px 52px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .topbar-left {
      font-size: 12px; color: rgba(255,255,255,0.6);
      display: flex; align-items: center; gap: 24px;
    }
    .topbar-left a { color: rgba(255,255,255,0.6); text-decoration: none; transition: color .15s; }
    .topbar-left a:hover { color: #fff; }
    .topbar-left span { display: flex; align-items: center; gap: 6px; }
    .topbar-right {
      display: flex; align-items: center; gap: 12px;
    }
    .topbar-phone {
      font-size: 13px; font-weight: 500; color: #fff;
      text-decoration: none; display: flex; align-items: center; gap: 6px;
      letter-spacing: 0.02em;
    }
    .topbar-phone:hover { color: rgba(255,255,255,0.85); }
    .topbar-phone svg { width: 14px; height: 14px; }
    .topbar-offerte {
      background: #fff; color: var(--navy);
      padding: 7px 18px; font-size: 12px; font-weight: 500;
      letter-spacing: 0.05em; text-transform: uppercase;
      text-decoration: none; transition: opacity .15s;
    }
    .topbar-offerte:hover { opacity: .88; }

    /* ── NAV ── */
    nav {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 52px;
      border-bottom: 1px solid var(--line);
      background: var(--paper);
      position: sticky; top: 0; z-index: 99;
    }
    .logo { text-decoration: none; }
    .logo-main { display: block; font-family: var(--serif); font-size: 17px; color: var(--navy); }
    .logo-sub  { display: block; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-top: 2px; }
    .nav-links { display: flex; align-items: center; gap: 32px; }
    .nav-links a { font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); text-decoration: none; transition: color .15s; }
    .nav-links a:hover { color: var(--ink); }
    .nav-cta {
      background: var(--navy) !important; color: #fff !important;
      padding: 9px 22px;
    }
    .nav-cta:hover { background: var(--blue) !important; color: #fff !important; }

    /* ── HERO ── */
    .hero {
      display: grid; grid-template-columns: 1.1fr 0.9fr;
      min-height: 420px; border-bottom: 1px solid var(--line);
    }
    .hero-l {
      padding: 72px 52px;
      display: flex; flex-direction: column; justify-content: center;
      border-right: 1px solid var(--line);
    }
    .hero-tag {
      font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--blue); margin-bottom: 24px;
      display: flex; align-items: center; gap: 8px;
    }
    .hero-tag::before { content: ''; width: 20px; height: 1px; background: var(--blue); }
    .hero-l h1 {
      font-family: var(--serif); font-size: 46px; line-height: 1.1;
      font-weight: 400; color: var(--ink); margin-bottom: 20px;
    }
    .hero-l h1 em { font-style: italic; color: var(--navy); }
    .hero-l p {
      font-size: 15px; color: var(--muted); line-height: 1.8;
      font-weight: 300; max-width: 380px; margin-bottom: 36px;
    }
    .hero-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .btn-offerte {
      background: var(--navy); color: #fff;
      padding: 13px 28px; font-family: var(--sans);
      font-size: 13px; letter-spacing: 0.04em;
      text-decoration: none; transition: background .15s;
    }
    .btn-offerte:hover { background: var(--blue); }
    .btn-bel {
      display: inline-flex; align-items: center; gap: 8px;
      color: var(--navy); font-size: 14px; font-weight: 500;
      text-decoration: none; border-bottom: 1px solid var(--line);
      padding-bottom: 2px; transition: border-color .15s, color .15s;
      letter-spacing: 0.02em;
    }
    .btn-bel:hover { color: var(--blue); border-color: var(--blue); }
    .btn-bel svg { width: 15px; height: 15px; }

    .hero-r {
      background: var(--sky);
      padding: 52px;
      display: flex; flex-direction: column; justify-content: center; gap: 0;
    }
    .usp {
      padding: 18px 0;
      border-bottom: 1px solid rgba(42,90,140,0.15);
      display: flex; align-items: flex-start; gap: 16px;
    }
    .usp:first-child { border-top: 1px solid rgba(42,90,140,0.15); }
    .usp-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--navy); flex-shrink: 0; margin-top: 5px;
    }
    .usp-title { font-size: 13px; font-weight: 500; color: var(--navy); margin-bottom: 3px; }
    .usp-text  { font-size: 12px; color: var(--blue); font-weight: 300; line-height: 1.5; opacity: .8; }

    /* ── WERKGEBIED ── */
    .gebied-bar {
      background: var(--navy); color: rgba(255,255,255,0.5);
      padding: 13px 52px;
      font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    }
    .gebied-bar strong { color: rgba(255,255,255,0.9); font-weight: 400; }

    /* ── DIENSTEN ── */
    .diensten { border-bottom: 1px solid var(--line); }
    .section-header { padding: 52px 52px 36px; border-bottom: 1px solid var(--line); }
    .section-label { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--blue); margin-bottom: 8px; }
    .section-title { font-family: var(--serif); font-size: 28px; font-weight: 400; color: var(--ink); }
    .diensten-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
    .dienst {
      padding: 36px 40px;
      border-right: 1px solid var(--line);
      transition: background .15s;
    }
    .dienst:last-child { border-right: none; }
    .dienst:hover { background: var(--sky); }
    .dienst-num { font-size: 11px; letter-spacing: 0.1em; color: var(--blue); margin-bottom: 14px; text-transform: uppercase; }
    .dienst h3 { font-family: var(--serif); font-size: 20px; font-weight: 400; color: var(--navy); margin-bottom: 10px; line-height: 1.2; }
    .dienst p  { font-size: 13px; color: var(--muted); line-height: 1.7; font-weight: 300; }

    /* ── WERKWIJZE ── */
    .werkwijze { border-bottom: 1px solid var(--line); }
    .stappen { display: grid; grid-template-columns: repeat(4, 1fr); }
    .stap {
      padding: 36px 40px;
      border-right: 1px solid var(--line);
    }
    .stap:last-child { border-right: none; }
    .stap-num { font-family: var(--serif); font-size: 40px; color: var(--line); margin-bottom: 14px; line-height: 1; }
    .stap h4 { font-size: 14px; font-weight: 500; color: var(--navy); margin-bottom: 8px; }
    .stap p  { font-size: 13px; color: var(--muted); font-weight: 300; line-height: 1.65; }

    /* ── VOOR WIE ── */
    .voor-wie { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--line); }
    .voor-wie-blok {
      padding: 52px;
      border-right: 1px solid var(--line);
    }
    .voor-wie-blok:last-child { border-right: none; background: var(--sky); }
    .voor-wie-blok h2 { font-family: var(--serif); font-size: 22px; font-weight: 400; color: var(--navy); margin-bottom: 12px; margin-top: 8px; }
    .voor-wie-blok p  { font-size: 14px; color: var(--muted); line-height: 1.8; font-weight: 300; }

    /* ── CONTACT ── */
    .contact { display: grid; grid-template-columns: 1fr 1fr; }
    .contact-l {
      padding: 64px 52px;
      border-right: 1px solid var(--line);
      display: flex; flex-direction: column; gap: 32px;
    }
    .contact-l h2 { font-family: var(--serif); font-size: 28px; font-weight: 400; color: var(--navy); }
    .contact-l > p { font-size: 14px; color: var(--muted); line-height: 1.8; font-weight: 300; max-width: 300px; }
    .contact-bel {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--navy); color: #fff;
      padding: 14px 28px; font-family: var(--sans);
      font-size: 15px; font-weight: 400; text-decoration: none;
      letter-spacing: 0.02em; transition: background .15s; width: fit-content;
    }
    .contact-bel:hover { background: var(--blue); }
    .contact-bel svg { width: 18px; height: 18px; }
    .contact-details { display: flex; flex-direction: column; gap: 12px; }
    .cd { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--ink); }
    .cd svg { color: var(--navy); flex-shrink: 0; }
    .cd a { color: var(--ink); text-decoration: none; }
    .cd a:hover { color: var(--navy); }

    /* ── FORM ── */
    .contact-r { padding: 64px 52px; background: var(--sky); }
    .form-kop { font-family: var(--serif); font-size: 22px; font-weight: 400; color: var(--navy); margin-bottom: 6px; }
    .form-sub { font-size: 13px; color: var(--muted); margin-bottom: 28px; font-weight: 300; }
    .form-row { margin-bottom: 16px; }
    .form-row label { display: block; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
    .form-row input,
    .form-row select,
    .form-row textarea {
      width: 100%; padding: 11px 14px;
      font-family: var(--sans); font-size: 13px; font-weight: 300;
      border: 1px solid var(--line); background: #fff; color: var(--ink);
      outline: none; border-radius: 0; appearance: none; transition: border-color .15s;
    }
    .form-row input:focus,
    .form-row select:focus,
    .form-row textarea:focus { border-color: var(--navy); }
    .form-row textarea { min-height: 85px; resize: vertical; }
    .form-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .form-submit {
      width: 100%; padding: 13px; margin-top: 4px;
      background: var(--navy); color: #fff; border: none;
      font-family: var(--sans); font-size: 12px; letter-spacing: 0.1em;
      text-transform: uppercase; cursor: pointer; transition: background .15s;
    }
    .form-submit:hover { background: var(--blue); }
    .form-success { display: none; padding: 40px 0; text-align: center; }
    .form-success strong { display: block; font-family: var(--serif); font-size: 22px; font-weight: 400; color: var(--navy); margin-bottom: 6px; }
    .form-success span { font-size: 13px; color: var(--muted); }

    /* ── FOOTER ── */
    footer {
      background: var(--navy);
      padding: 24px 52px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .f-logo { font-family: var(--serif); font-size: 15px; color: rgba(255,255,255,0.6); }
    .f-copy  { font-size: 11px; color: rgba(255,255,255,0.25); }

    /* ── RESPONSIVE ── */
    @media (max-width: 800px) {
      .topbar { padding: 10px 20px; }
      .topbar-left { display: none; }
      nav { padding: 14px 20px; }
      .nav-links a:not(.nav-cta) { display: none; }
      .hero, .voor-wie, .contact { grid-template-columns: 1fr; }
      .hero-l { padding: 48px 24px; border-right: none; border-bottom: 1px solid var(--line); }
      .hero-l h1 { font-size: 34px; }
      .hero-r { padding: 32px 24px; }
      .gebied-bar { padding: 12px 20px; }
      .section-header { padding: 36px 24px 24px; }
      .diensten-grid { grid-template-columns: 1fr; }
      .dienst { border-right: none; border-bottom: 1px solid var(--line); padding: 28px 24px; }
      .dienst:last-child { border-bottom: none; }
      .stappen { grid-template-columns: 1fr 1fr; }
      .stap { padding: 28px 20px; }
      .stap:nth-child(2n) { border-right: none; }
      .voor-wie-blok { padding: 36px 24px; border-right: none; border-bottom: 1px solid var(--line); }
      .voor-wie-blok:last-child { border-bottom: none; }
      .contact-l { padding: 48px 24px; border-right: none; border-bottom: 1px solid var(--line); gap: 24px; }
      .contact-r { padding: 48px 24px; }
      .form-2col { grid-template-columns: 1fr; }
      footer { padding: 20px 24px; flex-direction: column; gap: 6px; text-align: center; }
    }
  </style>
</head>
