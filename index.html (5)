<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Van Smoorenburg Totaalservice — Woningontruiming en wandmontage. Vakkundig, betrouwbaar en zonder gedoe." />
  <title>Van Smoorenburg Totaalservice</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body>

  <!-- ─── Nav ─── -->
  <nav>
    <a href="#" class="logo">
      <span class="logo-main">Van Smoorenburg</span>
      <span class="logo-sub">Totaalservice</span>
    </a>
    <div class="nav-links">
      <a href="#diensten">Diensten</a>
      <a href="#contact">Contact</a>
      <a href="#contact" class="btn">Offerte aanvragen</a>
    </div>
  </nav>

  <!-- ─── Hero ─── -->
  <section class="hero">
    <div class="hero-left">
      <p class="eyebrow">Vakkundig &amp; Betrouwbaar</p>
      <h1>Geregeld.<br><em>Netjes.</em><br>Klaar.</h1>
      <p>Van woningontruiming tot wandmontage — wij pakken het aan. Snel, eerlijk en zonder gedoe.</p>
      <div class="cta-row">
        <a href="#contact" class="btn-primary">Offerte aanvragen</a>
        <a href="#diensten" class="btn-secondary">Onze diensten</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="stat">
        <span class="stat-number">24u</span>
        <span class="stat-label">Reactietijd</span>
      </div>
      <div class="stat">
        <span class="stat-number">100%</span>
        <span class="stat-label">Vrijblijvende offerte</span>
      </div>
      <div class="stat">
        <span class="stat-number">NL</span>
        <span class="stat-label">Heel Nederland</span>
      </div>
    </div>
  </section>

  <!-- ─── Services ─── -->
  <section class="services" id="diensten">
    <div class="service">
      <p class="service-num">01 — Ontruiming</p>
      <h2>Woningontruiming</h2>
      <p>Bij overlijden, verhuizing of huurbeëindiging zorgen wij voor een volledige en respectvolle ontruiming. U hoeft niets te regelen.</p>
      <div class="tags">
        <span class="tag">Na overlijden</span>
        <span class="tag">Verhuizing</span>
        <span class="tag">Huurbeëindiging</span>
        <span class="tag">Inboedelafvoer</span>
      </div>
    </div>
    <div class="service">
      <p class="service-num">02 — Montage</p>
      <h2>Wandpanelen &amp; Montage</h2>
      <p>Strakke plaatsing van wandpanelen, lambrisering en interieurdelen. Vakkundig uitgevoerd, netjes opgeleverd.</p>
      <div class="tags">
        <span class="tag">Wandpanelen</span>
        <span class="tag">Lambrisering</span>
        <span class="tag">Plafondpanelen</span>
        <span class="tag">Interieurmontage</span>
      </div>
    </div>
  </section>

  <!-- ─── Strip ─── -->
  <div class="strip">
    <span class="strip-text">Geen gedoe. Gewoon goed werk.</span>
    <a href="#contact" class="strip-link">Neem contact op →</a>
  </div>

  <!-- ─── Contact ─── -->
  <section class="contact" id="contact">
    <div class="contact-info">
      <div>
        <h2>Neem contact op</h2>
        <p>Vraag vrijblijvend een offerte aan. Wij reageren binnen 24 uur.</p>
        <div class="contact-details">
          <div class="contact-item">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
            +31 6 00 00 00 00
          </div>
          <div class="contact-item">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
            info@vansmoorenburgtotaalservice.nl
          </div>
          <div class="contact-item">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
            Heel Nederland
          </div>
          <div class="contact-item">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Ma – Za · 8:00 – 18:00
          </div>
        </div>
      </div>
    </div>

    <div class="contact-form">
      <form id="contact-form">
        <div class="form-2col">
          <div class="form-row">
            <label for="voornaam">Voornaam</label>
            <input type="text" id="voornaam" name="voornaam" placeholder="Jan" required />
          </div>
          <div class="form-row">
            <label for="achternaam">Achternaam</label>
            <input type="text" id="achternaam" name="achternaam" placeholder="de Vries" required />
          </div>
        </div>
        <div class="form-row">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" placeholder="jan@email.nl" required />
        </div>
        <div class="form-row">
          <label for="telefoon">Telefoon</label>
          <input type="tel" id="telefoon" name="telefoon" placeholder="+31 6 ..." />
        </div>
        <div class="form-row">
          <label for="dienst">Dienst</label>
          <select id="dienst" name="dienst" required>
            <option value="">Selecteer een dienst</option>
            <option value="ontruiming-overlijden">Woningontruiming — na overlijden</option>
            <option value="ontruiming-verhuizing">Woningontruiming — verhuizing / huurbeëindiging</option>
            <option value="montage">Wandpanelen &amp; montage</option>
            <option value="combinatie">Combinatie van diensten</option>
          </select>
        </div>
        <div class="form-row">
          <label for="bericht">Bericht</label>
          <textarea id="bericht" name="bericht" placeholder="Korte omschrijving van uw situatie of klus..."></textarea>
        </div>
        <button type="submit" class="form-submit">Verstuur aanvraag</button>
      </form>
      <div id="form-success" class="form-success">
        <strong>Bedankt voor uw bericht.</strong>
        Wij nemen binnen 24 uur contact met u op.
      </div>
    </div>
  </section>

  <!-- ─── Footer ─── -->
  <footer>
    <span class="footer-logo">Van Smoorenburg Totaalservice</span>
    <span class="footer-copy">© 2025</span>
  </footer>

  <script src="js/main.js"></script>
</body>
</html>
