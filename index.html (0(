<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sjatijn — Satijnen Sjaaltjes</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --ink: #1a1612;
      --ink-soft: #6b5f55;
      --ink-muted: #a89d95;
      --bg: #faf8f5;
      --bg-warm: #f2ede6;
      --accent: #c9703a;
      --accent-light: #f5e8dc;
      --white: #ffffff;
      --border: rgba(26,22,18,0.10);
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans: 'Inter', system-ui, sans-serif;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }

    /* NAV */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 2.5rem;
      height: 64px;
      background: rgba(250,248,245,0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo {
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 400;
      letter-spacing: 0.06em;
      color: var(--ink);
      text-decoration: none;
    }
    .nav-links {
      display: flex; gap: 2.5rem; list-style: none;
    }
    .nav-links a {
      font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--ink-soft); text-decoration: none; font-weight: 400;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--ink); }
    .nav-right {
      display: flex; align-items: center; gap: 1.5rem;
    }
    .nav-cart {
      font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--ink-soft); cursor: pointer; display: flex; align-items: center; gap: 6px;
    }
    .nav-cart svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.5; }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding-top: 64px;
    }
    .hero-left {
      display: flex; flex-direction: column; justify-content: center;
      padding: 5rem 4rem 5rem 5rem;
    }
    .hero-label {
      font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 2rem; font-weight: 500;
    }
    .hero-h1 {
      font-family: var(--serif);
      font-size: 72px; font-weight: 300; line-height: 1.0;
      letter-spacing: -0.01em;
      color: var(--ink);
      margin-bottom: 2rem;
    }
    .hero-h1 em {
      font-style: italic; color: var(--accent);
    }
    .hero-p {
      font-size: 15px; line-height: 1.8; color: var(--ink-soft);
      max-width: 340px; margin-bottom: 3rem; font-weight: 300;
    }
    .hero-actions {
      display: flex; align-items: center; gap: 2rem;
    }
    .btn {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 14px 32px;
      font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
      font-weight: 500; text-decoration: none; transition: all 0.25s;
    }
    .btn-dark {
      background: var(--ink); color: var(--bg);
    }
    .btn-dark:hover { background: #3a2f28; }
    .btn-ghost {
      color: var(--ink-soft); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
      text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: 2px;
      transition: color 0.2s, border-color 0.2s;
    }
    .btn-ghost:hover { color: var(--ink); border-color: var(--ink); }

    .hero-right {
      position: relative; overflow: hidden; background: var(--bg-warm);
    }
    .hero-right img {
      width: 100%; height: 100%; object-fit: cover;
      display: block;
    }
    .hero-pill {
      position: absolute; bottom: 2.5rem; left: 2.5rem;
      background: var(--white);
      padding: 1.1rem 1.5rem;
      display: flex; flex-direction: column; gap: 3px;
      border-left: 3px solid var(--accent);
    }
    .hero-pill-label {
      font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-muted);
    }
    .hero-pill-val {
      font-family: var(--serif); font-size: 32px; font-weight: 300; color: var(--ink);
      line-height: 1;
    }
    .hero-pill-sub {
      font-size: 10px; color: var(--ink-soft); letter-spacing: 0.08em;
    }

    /* TICKER */
    .ticker {
      background: var(--ink); color: var(--bg);
      padding: 12px 0; overflow: hidden;
      font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
      white-space: nowrap;
    }
    .ticker-inner {
      display: inline-flex; gap: 0;
      animation: ticker 24s linear infinite;
    }
    .ticker-item {
      padding: 0 3rem; opacity: 0.7;
    }
    .ticker-dot {
      color: var(--accent); opacity: 1; padding: 0 0.5rem;
    }
    @keyframes ticker {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    /* COLLECTION */
    .collection {
      padding: 6rem 5rem;
    }
    .section-header {
      display: flex; align-items: flex-end; justify-content: space-between;
      margin-bottom: 3.5rem;
    }
    .section-label {
      font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 0.75rem;
    }
    .section-title {
      font-family: var(--serif);
      font-size: 42px; font-weight: 300; line-height: 1.1; color: var(--ink);
    }

    .products {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px;
    }
    .product {
      position: relative; cursor: pointer; background: var(--bg-warm);
      overflow: hidden;
    }
    .product-img-wrap {
      aspect-ratio: 3/4; overflow: hidden; position: relative;
    }
    .product-img-wrap img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      display: block;
    }
    .product:hover .product-img-wrap img { transform: scale(1.06); }
    .product-overlay {
      position: absolute; inset: 0; background: rgba(26,22,18,0);
      transition: background 0.4s;
      display: flex; align-items: flex-end; padding: 1.5rem;
    }
    .product:hover .product-overlay { background: rgba(26,22,18,0.25); }
    .product-quick {
      opacity: 0; transform: translateY(8px);
      transition: all 0.3s;
      background: var(--white); color: var(--ink);
      font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
      padding: 10px 20px; font-weight: 500;
    }
    .product:hover .product-quick { opacity: 1; transform: translateY(0); }
    .product-tag {
      position: absolute; top: 1rem; left: 1rem;
      background: var(--accent); color: var(--white);
      font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase;
      padding: 4px 10px; font-weight: 500;
    }
    .product-info {
      padding: 1.25rem 1.25rem 1.5rem;
      background: var(--white);
    }
    .product-name {
      font-family: var(--serif); font-size: 18px; font-weight: 400;
      margin-bottom: 4px; color: var(--ink);
    }
    .product-desc {
      font-size: 12px; color: var(--ink-muted); margin-bottom: 0.75rem; font-weight: 300;
    }
    .product-price {
      font-size: 14px; font-weight: 500; color: var(--ink);
    }

    /* STORY */
    .story {
      display: grid; grid-template-columns: 1fr 1fr;
      background: var(--bg-warm);
    }
    .story-img {
      position: relative; overflow: hidden; min-height: 560px;
    }
    .story-img img {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }
    .story-text {
      display: flex; flex-direction: column; justify-content: center;
      padding: 5rem 5rem 5rem 5rem;
    }
    .story-text .section-label { margin-bottom: 1rem; }
    .story-h2 {
      font-family: var(--serif);
      font-size: 46px; font-weight: 300; line-height: 1.1;
      margin-bottom: 1.75rem; color: var(--ink);
    }
    .story-h2 em { font-style: italic; color: var(--accent); }
    .story-p {
      font-size: 14px; line-height: 1.9; color: var(--ink-soft);
      margin-bottom: 2.5rem; font-weight: 300; max-width: 420px;
    }

    /* USP ROW */
    .usps {
      display: grid; grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .usp {
      padding: 3rem 2rem; text-align: center;
      border-right: 1px solid var(--border);
    }
    .usp:last-child { border-right: none; }
    .usp-icon {
      width: 36px; height: 36px; margin: 0 auto 1.25rem;
      stroke: var(--accent); fill: none; stroke-width: 1.5;
    }
    .usp-title {
      font-family: var(--serif); font-size: 18px; font-weight: 400;
      margin-bottom: 0.5rem; color: var(--ink);
    }
    .usp-p {
      font-size: 12px; color: var(--ink-muted); line-height: 1.7; font-weight: 300;
    }

    /* GIFT BANNER */
    .gift-banner {
      padding: 7rem 5rem; text-align: center;
      background: var(--ink); color: var(--bg);
      position: relative; overflow: hidden;
    }
    .gift-label {
      font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 1.5rem;
    }
    .gift-title {
      font-family: var(--serif);
      font-size: 62px; font-weight: 300; line-height: 1.05;
      margin-bottom: 1.5rem;
    }
    .gift-title em { font-style: italic; color: var(--accent); }
    .gift-p {
      font-size: 15px; color: rgba(250,248,245,0.65); line-height: 1.8;
      max-width: 480px; margin: 0 auto 3rem; font-weight: 300;
    }
    .gift-decoration {
      position: absolute;
      font-family: var(--serif);
      font-size: 320px; font-weight: 300; opacity: 0.03;
      top: 50%; transform: translateY(-50%);
      line-height: 1; pointer-events: none; user-select: none;
    }
    .gift-deco-left { left: -80px; }
    .gift-deco-right { right: -80px; }

    /* FOOTER */
    footer {
      background: var(--white); border-top: 1px solid var(--border);
      padding: 3rem 5rem;
      display: grid; grid-template-columns: 1fr auto 1fr;
      align-items: center; gap: 2rem;
    }
    .footer-logo {
      font-family: var(--serif); font-size: 22px; font-weight: 400;
      letter-spacing: 0.06em; color: var(--ink);
    }
    .footer-center {
      display: flex; gap: 2rem; list-style: none;
    }
    .footer-center a {
      font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--ink-muted); text-decoration: none;
    }
    .footer-center a:hover { color: var(--ink); }
    .footer-right {
      text-align: right; font-size: 11px; color: var(--ink-muted);
      letter-spacing: 0.06em;
    }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; }
      .hero-left { padding: 3rem 2rem; }
      .hero-h1 { font-size: 52px; }
      .hero-right { min-height: 480px; }
      .collection { padding: 4rem 2rem; }
      .products { grid-template-columns: repeat(2, 1fr); }
      .story { grid-template-columns: 1fr; }
      .story-img { min-height: 360px; }
      .story-text { padding: 3rem 2rem; }
      .usps { grid-template-columns: repeat(2, 1fr); }
      .usp:nth-child(2) { border-right: none; }
      .gift-banner { padding: 5rem 2rem; }
      .gift-title { font-size: 42px; }
      footer { grid-template-columns: 1fr; text-align: center; }
      .footer-center { justify-content: center; }
      .footer-right { text-align: center; }
      nav { padding: 0 1.5rem; }
      .nav-links { display: none; }
    }
    @media (max-width: 560px) {
      .products { grid-template-columns: 1fr; }
      .usps { grid-template-columns: 1fr; }
      .usp { border-right: none; border-bottom: 1px solid var(--border); }
      .usp:last-child { border-bottom: none; }
    }
  </style>
</head>
